(in-package #:revision-backend-jj/tests)

;;; The working copy as a target: @ is a commit, the stamp is @'s parents,
;;; observing the disk snapshots, nothing on disk is ever written.

(defun wc (repo)
  (jj:make-jj-working-copy (open-store repo)))

(defmacro with-untouched-files ((repo) &body body)
  "BODY, then check every workspace file (bytes and mtime) is unchanged."
  (let ((files (gensym)))
    `(let ((,files (snapshot-of-workspace ,repo)))
       (multiple-value-prog1 (progn ,@body)
         (ok (equalp ,files (snapshot-of-workspace ,repo)) "workspace files byte-identical")))))

(defun dirty (repo)
  "Edit tracked.txt, add new.txt and dir/n.txt, add an ignored file, remove keep.txt."
  (put-file repo "tracked.txt" (lines "tracked" "edited"))
  (put-file repo "new.txt" (lines "new"))
  (put-file repo "dir/n.txt" (lines "n"))
  (put-file repo "ignored.txt" (lines "ignored"))
  (remove-file repo "keep.txt"))

(deftest working-copy-values
  (with-test-repo (r)
    (build-working-copy r)
    (let* ((s (open-store r))
           (w (jj:make-jj-working-copy s)))
      (ok (jj:jj-working-copy-p w))
      (ok (rev:revision-target-p w))
      (ok (eq s (jj:working-copy-store w)))
      (ok (equal (truename (trepo-dir r)) (truename (jj:working-copy-path w))))
      (ok (null (rev:target-fidelities w)))
      (ok (null (rev:target-transactional-p w))))))

(deftest target-revisions-are-the-parents-of-at
  (with-test-repo (r)
    (let ((k (build-working-copy r)))
      (ok (equal (list (getf k :base)) (rev:target-revisions (wc r))))))
  (with-test-repo (r)
    (ok (null (rev:target-revisions (wc r))) "@ on root(): unstamped"))
  (with-test-repo (r)
    (let ((k (build-merge r)))
      (new-change r (list (getf k :m1) (getf k :f2)) :at (+ +t0+ 900))
      (ok (equal (list (getf k :m1) (getf k :f2)) (rev:target-revisions (wc r)))
          "a merge @: both, in order"))))

(deftest target-state-snapshots
  (with-test-repo (r)
    (build-working-copy r)
    (dirty r)
    (let* ((w (wc r))
           (state (with-untouched-files (r) (rev:target-state w))))
      (ok (equal '(".gitignore" "dir/n.txt" "new.txt" "tracked.txt") (mapcar #'car (tree-files state)))
          "tracked and new files, not ignored ones, not removed ones")
      (ok (equal (lines "tracked" "edited") (diff:tree-file-content (file-at state "tracked.txt"))))
      (ok (equal (jj-paths r "@") (mapcar #'car (tree-files state)))
          "jj's @ now holds the snapshot")
      (ok (state= state (rev:revision-state (open-store r) "@"))))))

(deftest working-copy-revision
  (with-test-repo (r)
    (build-working-copy r)
    (let ((before (commit-of r "@")))
      (put-file r "new.txt" (lines "new"))
      (let ((rv (jj:working-copy-revision (wc r))))
        (ok (equal (change-of r "@") (rev:revision-id rv)))
        (ok (not (equal before (rev:revision-content rv))) "the snapshot rewrote @")
        (ok (file-at (rev:revision-state (open-store r) rv) "new.txt"))))))

(deftest target-drift-rules
  (with-test-repo (r)
    (let* ((k (build-working-copy r))
           (s (open-store r))
           (w (jj:make-jj-working-copy s)))
      (ok (null (rev:target-drift w s)) "clean")
      (put-file r "ignored.txt" (lines "ignored"))
      (ok (null (rev:target-drift w s)) "an ignored file is no drift")
      (dirty r)
      (let ((d (with-untouched-files (r) (rev:target-drift w s))))
        (ok (typep d 'diff:diff))
        (ok (eq :changes (diff:diff-level d)))
        (ok (state= (rev:target-state w) (diff:apply-diff (rev:revision-state s (getf k :base)) d))
            "stamp state + drift = working copy")
        (ok (subsetp '("tree:/dir/n.txt" "tree:/keep.txt" "tree:/new.txt" "tree:/tracked.txt")
                     (rev:delta-footprint d) :test #'equal)
            "every changed file is in the footprint (hunks may add text:/… entries)"))
      (ok (state= (rev:target-state w)
                  (diff:apply-diff (rev:revision-state s (getf k :base))
                                   (rev:state-diff s (getf k :base) w)))
          "state-diff accepts the working copy"))))

(deftest drift-of-an-unstamped-working-copy
  (with-test-repo (r)
    (put-file r "a.txt" (lines "a"))
    (let* ((s (open-store r))
           (w (jj:make-jj-working-copy s))
           (d (rev:target-drift w s)))
      (ok (state= (rev:target-state w) (diff:apply-diff (diff:make-tree) d))
          "against the empty tree"))))

(deftest drift-with-several-stamps-is-an-error
  (with-test-repo (r)
    (let* ((k (build-merge r))
           (s (open-store r)))
      (new-change r (list (getf k :m1) (getf k :f2)) :at (+ +t0+ 900))
      (ok (signals (rev:target-drift (jj:make-jj-working-copy s) s) 'rev:revision-error)))))

(deftest target-stamp-keeps-files-and-tree
  (with-test-repo (r)
    (let* ((k (build-linear r))
           (s (open-store r))
           (w (jj:make-jj-working-copy s))
           (old-wc (getf k :wc)))
      (put-file r "a.txt" (lines "dirty"))
      (let ((before (rev:target-state w)))
        (ok (equal (list (getf k :c1))
                   (with-untouched-files (r) (rev:target-stamp w (list (getf k :c1))))))
        (ok (equal (list (getf k :c1)) (rev:target-revisions w)))
        (ok (equal (list (getf k :c1)) (changes-of r "@-")) "jj: @ is on c1")
        (ok (state= before (rev:target-state w)) "@ keeps the tree")
        (ok (not (member old-wc (changes-of r "all()") :test #'equal)) "the old @ is abandoned")
        (ok (state= before (diff:apply-diff (rev:revision-state s (getf k :c1)) (rev:target-drift w s)))
            "drift is now measured from c1"))
      (testing "revisions as REVISION objects, and NIL"
        (ok (equal (list (getf k :c2))
                   (rev:target-stamp w (list (rev:resolve-revision s (getf k :c2))))))
        (ok (null (with-untouched-files (r) (rev:target-stamp w nil))))
        (ok (null (rev:target-revisions w)))
        (ok (equal '("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz") (changes-of r "@-")) "@ on root()")))))

(deftest target-stamp-several-revisions
  (with-test-repo (r)
    (let* ((k (build-merge r))
           (w (wc r)))
      (ok (equal (list (getf k :m1) (getf k :f2))
                 (with-untouched-files (r)
                   (rev:target-stamp w (list (getf k :m1) (getf k :f2) (getf k :m1))))))
      (ok (equal (list (getf k :m1) (getf k :f2)) (rev:target-revisions w)) "duplicates removed"))))

(deftest capture-with-default-parents
  (with-test-repo (r)
    (let* ((k (build-working-copy r))
           (s (open-store r))
           (w (jj:make-jj-working-copy s))
           (old-wc (change-of r "@")))
      (dirty r)
      (let* ((state (rev:target-state w))
             (rv (with-untouched-files (r) (rev:capture-revision w s))))
        (ok (equal old-wc (rev:revision-id rv)) "the captured revision is the old @ change")
        (ok (equal (list (getf k :base)) (rev:revision-parent-ids rv)))
        (ok (equal "capture" (rev:revision-message rv)))
        (ok (state= state (rev:revision-state s rv)))
        (ok (equal (list (rev:revision-id rv)) (rev:target-revisions w)))
        (ok (null (rev:target-drift w s)) "no drift afterwards")
        (ok (equal (list old-wc) (changes-of r "@-")) "jj: @ is a new change on it")
        (ok (equal "true" (jj-field r "@" "empty")))))))

(deftest capture-with-other-parents
  (with-test-repo (r)
    (let* ((k (build-linear r))
           (s (open-store r))
           (w (jj:make-jj-working-copy s))
           (old-wc (getf k :wc)))
      (put-file r "a.txt" (lines "captured"))
      (let* ((state (rev:target-state w))
             (rv (with-untouched-files (r)
                   (rev:capture-revision w s :parents (list (getf k :c1)) :message "on c1"))))
        (ok (not (equal old-wc (rev:revision-id rv))) "a new change")
        (ok (equal (list (getf k :c1)) (rev:revision-parent-ids rv)))
        (ok (equal "on c1" (rev:revision-message rv)))
        (ok (state= state (rev:revision-state s rv)) "the working copy's state, not c1 + @'s diff")
        (ok (equal (list (rev:revision-id rv)) (rev:target-revisions w)))
        (ok (null (rev:target-drift w s)))
        (ok (not (member old-wc (changes-of r "all()") :test #'equal)) "the old @ is abandoned")))))

(deftest capture-of-a-fresh-repository
  (with-test-repo (r)
    (put-file r "a.txt" (lines "a"))
    (let* ((s (open-store r))
           (w (jj:make-jj-working-copy s))
           (rv (rev:capture-revision w s :message "first")))
      (ok (null (rev:revision-parent-ids rv)))
      (ok (equal (lines "a") (diff:tree-file-content (file-at (rev:revision-state s rv) "a.txt"))))
      (ok (null (rev:target-drift w s))))))
