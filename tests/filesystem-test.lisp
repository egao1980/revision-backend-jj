(in-package #:revision-backend-jj/tests)

;;; REVISION-FILESYSTEM through the cl-stack-pathlib facade.

(defmacro with-revision-fs ((fs store designator) &body body)
  `(let ((,fs (jj:make-revision-filesystem ,store ,designator)))
     (pathlib:with-filesystem (,fs) ,@body)))

(deftest revision-filesystem-values
  (with-test-repo (r)
    (let* ((k (build-content r))
           (s (open-store r))
           (fs (jj:make-revision-filesystem s (rev:rev-ref "main"))))
      (ok (jj:revision-filesystem-p fs))
      (ok (typep fs 'pathlib:filesystem))
      (ok (eq s (jj:revision-filesystem-store fs)))
      (ok (rev:revision-p (jj:revision-filesystem-revision fs)))
      (ok (equal (getf k :k3) (rev:revision-id (jj:revision-filesystem-revision fs))))
      (ok (equal (commit-of r (getf k :k3)) (rev:revision-content (jj:revision-filesystem-revision fs)))
          "pinned to the commit id")
      (ok (signals (jj:make-revision-filesystem s "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef")
                   'rev:revision-not-found)))))

(deftest read-files-at-any-revision
  (with-test-repo (r)
    (let* ((k (build-content r))
           (s (open-store r)))
      (with-revision-fs (fs s (getf k :k1))
        (ok (equal +main-v1+ (pathlib:read-text "/src/main.lisp")))
        (ok (equal (lines "hello") (pathlib:read-text "README")) "relative to /")
        (ok (equalp +bin-v1+ (pathlib:read-bytes "/bin/data.bin")) "binary exact")
        (ok (equalp (utf8 +crlf-v1+) (pathlib:read-bytes "/crlf.txt")) "CRLF exact")
        (ok (equalp +latin-v1+ (pathlib:read-bytes "/latin.txt")))
        (ok (equal "" (pathlib:read-text "/empty.txt")))
        (ok (pathlib:file-p "/old/name.txt"))
        (ok (not (pathlib:exists-p "/new/name.txt"))))
      (with-revision-fs (fs s (getf k :k2))
        (ok (equal +main-v2+ (pathlib:read-text "/src/main.lisp")))
        (ok (equal +ten-lines-edited+ (pathlib:read-text "/new/name.txt")))
        (ok (not (pathlib:exists-p "/old/name.txt"))))
      (testing "pinned: moving the bookmark or rewriting the change does not change what it reads"
        (let ((fs (jj:make-revision-filesystem s (rev:rev-ref "main"))))
          (rev:move-ref s "main" (getf k :k1))
          (put-file r "thing/inner.txt" (lines "rewritten"))
          (jj* r (list "squash" "--into" (getf k :k3) "--use-destination-message")
               :env (time-env (+ +t0+ 900)))
          (pathlib:with-filesystem (fs)
            (ok (pathlib:directory-p "/thing"))
            (ok (equal (lines "inner") (pathlib:read-text "/thing/inner.txt")))))))))

(deftest listing-and-predicates
  (with-test-repo (r)
    (let* ((k (build-content r))
           (s (open-store r)))
      (with-revision-fs (fs s (getf k :k2))
        (let ((top (remove-duplicates
                    (mapcar (lambda (p) (first (uiop:split-string p :separator '(#\/))))
                            (jj-paths r (getf k :k2)))
                    :test #'equal)))
          (ok (equal (sort top #'string<) (mapcar #'pathlib:name (pathlib:iterdir "/")))
              "iterdir sorted by name"))
        (ok (equal '("name.txt") (mapcar #'pathlib:name (pathlib:iterdir "/new"))))
        (ok (pathlib:directory-p "/src"))
        (ok (pathlib:directory-p "/"))
        (ok (not (pathlib:file-p "/src")))
        (ok (pathlib:executable-p "/run.sh"))
        (ok (not (pathlib:executable-p "/README")))
        (ok (not (pathlib:writable-p "/README")))
        (ok (pathlib:readable-p "/README"))
        (ok (= 9 (pathlib:file-size "/bin/data.bin")))
        (ok (= (length (utf8 +main-v2+)) (pathlib:file-size "/src/main.lisp")))
        (unless (windows-p)
          (ok (pathlib:symlink-p "/link"))
          (ok (equal "src/main.lisp" (pathlib:as-posix (pathlib:read-symlink "/link")))))
        (ok (not (pathlib:symlink-p "/README")))
        (ok (= (+ (encode-universal-time 0 0 0 1 1 1970 0) (+ +t0+ 100))
               (pathlib:last-modified "/README"))
            "the commit's committer timestamp")
        (ok (set= (jj-paths r (getf k :k2))
                  (loop for (dir files) in (pathlib:walk "/")
                        nconc (mapcar (lambda (f) (string-left-trim "/" (pathlib:as-posix f))) files)))
            "walk reaches every file")
        (ok (set= '("/src/main.lisp")
                  (mapcar #'pathlib:as-posix (pathlib:rglob "/" "*.lisp"))))))))

(deftest stat-and-hash
  (with-test-repo (r)
    (let* ((k (build-content r))
           (s (open-store r)))
      (with-revision-fs (fs s (getf k :k2))
        (let ((st (pathlib:stat "/run.sh")))
          (ok (eq :file (pathlib:file-stat-kind st)))
          (ok (= 9 (pathlib:file-stat-size st)))
          (ok (= #o755 (pathlib:file-stat-mode st))))
        (ok (= #o644 (pathlib:file-stat-mode (pathlib:stat "/README"))))
        (ok (eq :directory (pathlib:file-stat-kind (pathlib:stat "/src"))))
        (ok (equal (pathlib:octets-hash +bin-v2+) (pathlib:content-hash "/bin/data.bin")))
        (ok (equal (list (lines "1") (lines "2"))
                   (mapcar (lambda (l) (format nil "~a~%" l))
                           (pathlib:read-lines "/new/name.txt" :start 1 :end 2))))))))

(deftest read-only-and-missing
  (with-test-repo (r)
    (let* ((k (build-content r))
           (s (open-store r)))
      (with-revision-fs (fs s (getf k :k2))
        (ok (signals (pathlib:write-text "/README" "x") 'pathlib:unsupported-operation))
        (ok (signals (pathlib:mkdir "/newdir") 'pathlib:unsupported-operation))
        (ok (signals (pathlib:delete-path "/README") 'pathlib:unsupported-operation))
        (ok (signals (pathlib:rename-path "/README" "/R2") 'pathlib:unsupported-operation))
        (ok (signals (pathlib:read-bytes "/nope.txt") 'pathlib:path-not-found))
        (ok (signals (pathlib:file-size "/nope.txt") 'pathlib:path-not-found))
        (ok (signals (pathlib:iterdir "/nope") 'pathlib:path-not-found))
        (ok (equal (lines "hello") (pathlib:read-text "/README")) "unchanged")))))

(deftest conflicted-files-read-as-materialized
  (with-test-repo (r)
    (let* ((k (build-conflict r))
           (s (open-store r)))
      (with-revision-fs (fs s (getf k :m))
        (ok (pathlib:file-p "/a.txt"))
        (ok (equalp (materialized r (getf k :m) "a.txt") (pathlib:read-bytes "/a.txt")))
        (ok (= (length (materialized r (getf k :m) "a.txt")) (pathlib:file-size "/a.txt")))))))

(deftest revision-path-facade
  (with-test-repo (r)
    (let* ((k (build-content r))
           (s (open-store r)))
      (let ((p (jj:revision-path s (getf k :k1) "/src/main.lisp")))
        (ok (pathlib:path-p p))
        (ok (jj:revision-filesystem-p (pathlib:path-filesystem p)))
        (ok (equal +main-v1+ (pathlib:read-text p)))
        (ok (equal (lines "hello")
                   (pathlib:read-text (pathlib:join (pathlib:parent (pathlib:parent p)) "README")))))
      (let ((root (jj:revision-path s (rev:rev-ref "main"))))
        (ok (pathlib:directory-p root))
        (ok (equal (lines "inner") (pathlib:read-text (pathlib:join root "thing/inner.txt"))))))))
