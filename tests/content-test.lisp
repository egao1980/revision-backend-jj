(in-package #:revision-backend-jj/tests)

;;; Content: states as tree values (text / binary / modes / symlinks),
;;; deltas, and STATE-DIFF at every level against jj (law 3 rows included).

(defun mode-of (file)
  (or (diff:tree-file-mode file) #o100644))

(defun k1-files ()
  ;; path type content mode
  (append
   `(("README" :text ,(lines "hello") #o100644)
     ("bin/data.bin" :binary ,+bin-v1+ #o100644)
     ("crlf.txt" :text ,+crlf-v1+ #o100644)
     ("empty.txt" :text "" #o100644)
     ("latin.txt" :binary ,+latin-v1+ #o100644))
   (unless (windows-p) `(("link" :text "README" #o120000)))
   `(("old/name.txt" :text ,+ten-lines+ #o100644)
     ("run.sh" :text ,(lines "echo run") #o100644)
     ("src/main.lisp" :text ,+main-v1+ #o100644)
     ("thing" :text ,(lines "a file") #o100644))))

(defun no-opaque-p (d)
  (labels ((walk (changes)
             (every (lambda (c) (and (not (typep c 'diff:opaque-change))
                                     (walk (diff:change-children c))))
                    changes)))
    (walk (diff:diff-changes d))))

(defun change-paths (d)
  (mapcar #'diff:change-path (diff:diff-changes d)))

(deftest content-primary-and-engine
  (with-test-repo (r)
    (let ((s (open-store r)))
      (ok (eq :state (rev:content-primary s)))
      (ok (typep (rev:content-engine s) 'diff:tree-diff-engine)))))

(deftest revision-state-reads-every-kind-of-file
  (with-test-repo (r)
    (let* ((k (build-content r))
           (s (open-store r)))
      (let ((state (rev:revision-state s (getf k :k1))))
        (ok (diff:tree-dir-p state))
        (ok (equal (mapcar #'first (k1-files)) (mapcar #'car (tree-files state))) "every file, sorted")
        (ok (equal (jj-paths r (getf k :k1)) (mapcar #'car (tree-files state))) "jj file list agrees")
        (dolist (row (k1-files))
          (destructuring-bind (path type content mode) row
            (let ((f (file-at state path)))
              (ok (and f
                       (eq type (diff:tree-file-type f))
                       (equalp content (diff:tree-file-content f))
                       (= mode (mode-of f)))
                  (format nil "~a: ~(~a~) ~o" path type mode))))))
      (let ((state (rev:revision-state s (getf k :k2))))
        (ok (= #o100755 (mode-of (file-at state "run.sh"))) "executable bit")
        (unless (windows-p)
          (ok (equal "src/main.lisp" (diff:tree-file-content (file-at state "link"))) "symlink target"))
        (ok (equalp +bin-v2+ (diff:tree-file-content (file-at state "bin/data.bin"))))
        (ok (equal +crlf-v2+ (diff:tree-file-content (file-at state "crlf.txt"))))
        (ok (null (file-at state "empty.txt")))
        (ok (null (file-at state "old/name.txt")))
        (ok (equal +ten-lines-edited+ (diff:tree-file-content (file-at state "new/name.txt")))))
      (let ((state (rev:revision-state s (getf k :k3))))
        (ok (diff:tree-dir-p (diff:tree-get state '("thing"))) "file replaced by a directory")
        (ok (equal (lines "inner") (diff:tree-file-content (file-at state "thing/inner.txt")))))
      (testing "every file's bytes equal jj file show"
        (let ((state (rev:revision-state s (getf k :k2))))
          (dolist (entry (tree-files state))
            (unless (= #o120000 (mode-of (cdr entry)))
              (let ((content (diff:tree-file-content (cdr entry))))
                (ok (equalp (jj-file r (getf k :k2) (car entry))
                            (if (stringp content) (utf8 content) content))
                    (car entry))))))))))

(deftest revision-state-of-the-working-copy-commit
  (with-test-repo (r)
    (build-working-copy r)
    (let ((s (open-store r)))
      (put-file r "unsnapshotted.txt" "x")
      (ok (null (file-at (rev:revision-state s "@") "unsnapshotted.txt"))
          "reads never snapshot: @ as last recorded")
      (ok (equal (lines "tracked") (diff:tree-file-content (file-at (rev:revision-state s "@") "tracked.txt")))))))

(deftest revision-delta-against-the-first-parent
  (with-test-repo (r)
    (let* ((k (build-content r))
           (s (open-store r)))
      (let ((d2 (rev:revision-delta s (getf k :k2)))
            (d1 (rev:revision-delta s (getf k :k1))))
        (ok (typep d2 'diff:diff))
        (ok (state= (rev:revision-state s (getf k :k2))
                    (diff:apply-diff (rev:revision-state s (getf k :k1)) d2)))
        (ok (state= (rev:revision-state s (getf k :k1)) (diff:apply-diff (diff:make-tree) d1))
            "a root change's delta is from the empty tree")))
    (with-test-repo (r2)
      (let* ((k (build-merge r2))
             (s (open-store r2)))
        (ok (state= (rev:revision-state s (getf k :x))
                    (diff:apply-diff (rev:revision-state s (getf k :m1)) (rev:revision-delta s (getf k :x))))
            "a merge's delta is against its first parent")
        (ok (member '("feature.txt") (change-paths (rev:revision-delta s (getf k :x))) :test #'equal)
            "so the merge adds feature.txt")))))

(deftest state-diff-summary-matches-jj
  (with-test-repo (r)
    (let* ((k (build-content r))
           (s (open-store r))
           (d (rev:state-diff s (getf k :k1) (getf k :k2) :level :summary))
           (jj-records (jj-lines r "diff" "--from" (getf k :k1) "--to" (getf k :k2)
                                 "-T" "status_char ++ \" \" ++ path ++ \"\\n\"")))
      (ok (eq :summary (diff:diff-level d)))
      (ok (= (length jj-records) (length (diff:diff-changes d))) "one change per file jj reports")
      (dolist (line jj-records)
        (let* ((status (char line 0))
               (path (uiop:split-string (subseq line 2) :separator '(#\/)))
               (c (find path (diff:diff-changes d) :key #'diff:change-path :test #'equal)))
          (ok c line)
          (when c
            (ok (eq (ecase status (#\M :modify) (#\A :add) (#\D :remove) (#\R :move) (#\C :add))
                    (diff:change-kind c))
                line)
            (ok (null (diff:change-children c)))
            (ok (member (format nil "tree:/~{~a~^/~}" path) (diff:change-footprint c)
                        :test #'equal)))))
      (let ((c (find '("src" "main.lisp") (diff:diff-changes d) :key #'diff:change-path :test #'equal)))
        (when c
          (ok (not (diff:change-before-loaded-p c)) "nodes are read lazily")
          (ok (equal +main-v2+ (diff:tree-file-content (diff:change-after c)))))))))

(deftest state-diff-changes-and-content-shapes
  (with-test-repo (r)
    (let* ((k (build-content r))
           (s (open-store r))
           (changes (rev:state-diff s (getf k :k1) (getf k :k2)))
           (content (rev:state-diff s (getf k :k1) (getf k :k2) :level :content)))
      (ok (eq :changes (diff:diff-level changes)) "default level")
      (ok (no-opaque-p changes))
      (ok (no-opaque-p content))
      (ok (some (lambda (p) (and (equal "src" (first p)) (equal "main.lisp" (second p)) (cddr p)))
                (change-paths changes))
          "text edits are hunks under the file path")
      (ok (member '("bin" "data.bin") (change-paths changes) :test #'equal)
          "a binary file is one whole-file change …")
      (ok (notany (lambda (p) (and (> (length p) 2) (equal '("bin" "data.bin") (subseq p 0 2))))
                  (change-paths changes))
          "… with no hunks")
      (let ((bin (find '("bin" "data.bin") (diff:diff-changes changes)
                       :key #'diff:change-path :test #'equal)))
        (when bin
          (ok (equalp +bin-v1+ (diff:tree-file-content (diff:change-before bin))))
          (ok (equalp +bin-v2+ (diff:tree-file-content (diff:change-after bin))))))
      (let ((main (find '("src" "main.lisp") (diff:diff-changes content)
                        :key #'diff:change-path :test #'equal)))
        (ok main ":content: file-level changes …")
        (when main (ok (diff:change-children main) "… with their hunks as children"))))))

(deftest-parametrize state-diff-laws
    ((from to level) :ids ("k1-k2-summary" "k1-k2-changes" "k1-k2-content" "k2-k3-changes"
                           "k3-k1-changes" "k1-k3-content" "k2-k1-summary")
     (:k1 :k2 :summary) (:k1 :k2 :changes) (:k1 :k2 :content) (:k2 :k3 :changes)
     (:k3 :k1 :changes) (:k1 :k3 :content) (:k2 :k1 :summary))
  (with-test-repo (r)
    (let* ((k (build-content r))
           (s (open-store r))
           (a (rev:revision-state s (getf k from)))
           (b (rev:revision-state s (getf k to)))
           (d (rev:state-diff s (getf k from) (getf k to) :level level)))
      (ok (state= b (diff:apply-diff a d)) "apply(state a, diff a b) = state b")
      (let ((inverse (rev:delta-inverse d)))
        (ok inverse "every jj state-diff inverts")
        (when inverse (ok (state= a (diff:apply-diff b inverse)) "and the inverse undoes it")))
      (ok (diff:diff-empty-p (rev:state-diff s (getf k from) (getf k from) :level level))
          "self-diff is empty"))))

(deftest state-diff-footprint
  (with-test-repo (r)
    (let* ((k (build-content r))
           (s (open-store r))
           (d (rev:state-diff s (getf k :k1) (getf k :k2) :footprint '("tree:/src") :level :summary)))
      (ok (equal '(("src" "main.lisp")) (change-paths d)))
      (ok (equal '("tree:/src/main.lisp") (rev:delta-footprint d))))))

(deftest state-diff-with-a-rewritten-change
  (with-test-repo (r)
    (let* ((k (build-linear r))
           (s (open-store r))
           (old (rev:resolve-revision s (getf k :c3))))
      (put-file r "dir/c.txt" (lines "changed"))
      (jj* r (list "squash" "--into" (getf k :c3) "-m" "squashed") :env (time-env (+ +t0+ 500)))
      (ok (equal (list '("dir" "c.txt") ) (remove-duplicates (mapcar (lambda (p) (subseq p 0 2))
                                                                     (change-paths (rev:state-diff s old (getf k :c3))))
                                                             :test #'equal))
          "the pinned old snapshot against the change's current commit"))))
